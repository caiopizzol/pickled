diff --git a/pickled.yml b/pickled.yml
new file mode 100644
index 0000000..671c7a1
--- /dev/null
+++ b/pickled.yml
@@ -0,0 +1,53 @@
+schemaVersion: 2
+
+product:
+  name: BrineKit
+  description: CLI fixture for Pickled config authoring
+
+sources:
+  llms: { path: ./llms.txt }
+
+agents:
+  quick:
+    provider: claude-code
+    model: claude-haiku-4-5
+    maxTurns: 5
+
+contexts:
+  memory: { mode: memory }
+  given_llms: { mode: inject, source: llms }
+
+facts:
+  install_command:
+    statement: BrineKit is installed with bunx brinekit init.
+    match:
+      allOf: ["bunx brinekit init"]
+
+misstatements:
+  npm_install:
+    statement: The answer recommends installing BrineKit with npm.
+    match:
+      anyOf: ["npm install brinekit"]
+
+questions:
+  - id: install
+    question: How do I install BrineKit?
+    agents: [quick]
+    contexts: [memory, given_llms]
+    expects: [install_command]
+    rejects: [npm_install]
+    examples:
+      pass: ["Install BrineKit with bunx brinekit init."]
+      fail: ["Install BrineKit with npm install brinekit."]
+
+builds:
+  - id: smoke_build
+    goal: Create configured.txt in the BrineKit workspace.
+    agents: [quick]
+    contexts: [given_llms]
+    trials: 2
+    workspace:
+      path: ./workspace
+    verifier:
+      failToPass:
+        - { run: test -f configured.txt }
