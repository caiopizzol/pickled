{
  "tagFormat": "cli-v${version}",
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [{ "breaking": true, "release": "minor" }]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node -e \"const p=require('./package.json');p.version='${nextRelease.version}';require('fs').writeFileSync('package.json',JSON.stringify(p,null,2)+'\\n')\" && bun run build",
        "publishCmd": "npm publish --access public"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["package.json"],
        "message": "chore(release): cli-v${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "releasedLabels": ["released"]
      }
    ]
  ]
}
