# Old /docs/* paths were the canonical docs URLs before the URL
# flatten. They are still live on docs.pickled.dev at the moment of
# this deploy (dogfood scenarios, prior CI runs, and any in-flight
# links use them), so this file 301s them to the new flat paths to
# avoid turning currently working public URLs into 404s. New canonical
# is the subdomain root; the redirects are one-way (old -> new).

/docs                 /                    301
/docs/*               /:splat              301
/llms.mdx/docs/*      /llms.mdx/:splat     301
/og/docs/*            /og/:splat           301

# Access folded into the pickled.yml reference. matrix-evaluation and
# toolsets (earlier merged into Access) point at the same section, so the
# old URLs reach the content in one hop rather than chaining through /access.
/access                       /pickled-yml#access    301
/matrix-evaluation            /pickled-yml#access    301
/toolsets                     /pickled-yml#access    301
/llms.mdx/access              /llms.mdx/pickled-yml  301
/llms.mdx/matrix-evaluation   /llms.mdx/pickled-yml  301
/llms.mdx/toolsets            /llms.mdx/pickled-yml  301
/og/access                    /og/pickled-yml        301
/og/matrix-evaluation         /og/pickled-yml        301
/og/toolsets                  /og/pickled-yml        301
